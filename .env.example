# Copy this file to .env.local and fill in your keys. .env.local is git-ignored.
# Never paste keys into chats or commit them.

# Qloo hackathon key (emailed after the API key request form). Only works against this base URL.
QLOO_API_KEY=
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# Save real Qloo responses to data/qloo-fixtures/ as a local demo backup (git-ignored).
# Leave this off on Vercel: its filesystem is read-only.
QLOO_CAPTURE=true

# Google Gemini key for the planning agent (https://aistudio.google.com/apikey).
# Without it, Back Then's rules plan the kit instead and the app says so.
GEMINI_API_KEY=
# Check Google's current model list; change this if the default has been retired.
GEMINI_MODEL=gemini-3.5-flash
